<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name = "viewmodel"
            type = "com.avanzo.avanzotestsimulator.ui.home.viewmodel.UserViewModel"
            />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app"
        >

        <ImageButton
            android:id="@+id/logoutButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="17dp"
            android:layout_marginEnd="17dp"
            android:background="@null"
            android:scaleType="fitCenter"
            android:contentDescription="Logout button"
            android:src="@drawable/baseline_logout_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="17dp"
            android:layout_marginStart="17dp"
            android:background="@null"
            android:scaleType="fitCenter"
            android:contentDescription="Back Button"
            android:src="@drawable/baseline_keyboard_backspace_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_gap"
            android:text="@string/back"
            android:textSize="20dp"
            style="@style/GilroyFontBold"
            android:textColor="@color/white"
            app:layout_constraintStart_toEndOf="@+id/backButton"
            app:layout_constraintTop_toTopOf="@+id/backButton"
            app:layout_constraintBottom_toBottomOf="@+id/backButton"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/backButton"
            app:layout_constraintBottom_toTopOf="@+id/bg">

            <TextView
                android:id="@+id/userInitial"
                style="@style/GilroyFontLight"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:background="@drawable/circle_background"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="50dp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/profile_title"
                android:textSize="30dp"
                style="@style/GilroyFontBold"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/userInitial"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bg"
            android:backgroundTint="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.72"
            android:background="@drawable/background_with_border"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/line"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:layout_marginTop="@dimen/small_gap"
                android:background="@drawable/bg_app"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:indeterminateTint="@color/main"
                android:visibility="visible"
                android:layout_marginBottom="@dimen/big_gap"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/line"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainSection"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/small_gap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/line"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pointsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/pointsIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_star_24"
                        app:layout_constraintEnd_toStartOf="@+id/numberPoints"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/pointsIcon">

                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:id="@+id/numberPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:textSize="20dp"
                        style="@style/GilroyFontBold"
                        android:textColor="@color/black_main"
                        app:layout_constraintStart_toEndOf="@+id/pointsIcon"
                        app:layout_constraintTop_toTopOf="@+id/pointsIcon"
                        app:layout_constraintBottom_toBottomOf="@+id/pointsIcon" />

                    <TextView
                        android:id="@+id/textPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/points_title"
                        android:layout_marginLeft="5dp"
                        android:textSize="20dp"
                        style="@style/GilroyFontBold"
                        android:textColor="@color/black_main"
                        app:layout_constraintStart_toEndOf="@+id/numberPoints"
                        app:layout_constraintTop_toTopOf="@+id/pointsIcon"
                        app:layout_constraintBottom_toBottomOf="@+id/pointsIcon" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <EditText
                    android:id="@+id/editTextName"
                    android:enabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/border_radius3"
                    android:padding="15dp"
                    android:textSize="16dp"
                    android:drawableLeft="@drawable/baseline_person_24"
                    android:drawablePadding="10dp"
                    android:textColor="@color/black"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:hint="@string/name"
                    android:textStyle="bold"
                    style="@style/GilroyFontLight"
                    android:textColorHint="@color/gray"
                    app:layout_constraintTop_toBottomOf="@+id/pointsContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <EditText
                    android:id="@+id/editTextLastName"
                    android:enabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/border_radius3"
                    android:padding="15dp"
                    android:textSize="16dp"
                    android:drawableLeft="@drawable/baseline_person_24"
                    android:drawablePadding="10dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    style="@style/GilroyFontLight"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:hint="@string/last_name"
                    android:textColorHint="@color/gray"
                    app:layout_constraintTop_toBottomOf="@+id/editTextName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <EditText
                    android:id="@+id/editTextEmail"
                    android:enabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/border_radius3"
                    android:padding="15dp"
                    android:textSize="16dp"
                    android:drawableLeft="@drawable/baseline_email_24"
                    android:drawablePadding="10dp"
                    android:textStyle="bold"
                    style="@style/GilroyFontLight"
                    android:textColor="@color/black"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:hint="@string/hint_email_login"
                    android:textColorHint="@color/gray"
                    app:layout_constraintTop_toBottomOf="@+id/editTextLastName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <EditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/border_radius2"
                    android:padding="15dp"
                    android:textSize="16dp"
                    android:drawableLeft="@drawable/baseline_lock_24"
                    android:drawablePadding="10dp"
                    android:textStyle="bold"
                    style="@style/GilroyFontLight"
                    android:inputType="textPassword"
                    android:textColor="@color/black"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:hint="@string/new_password"
                    android:textColorHint="@color/gray"
                    app:layout_constraintTop_toBottomOf="@+id/editTextEmail"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <EditText
                    android:id="@+id/editTextPasswordConfirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/border_radius2"
                    android:padding="15dp"
                    android:textSize="16dp"
                    android:drawableLeft="@drawable/baseline_lock_24"
                    android:drawablePadding="10dp"
                    android:textStyle="bold"
                    style="@style/GilroyFontLight"
                    android:inputType="textPassword"
                    android:textColor="@color/black"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:hint="@string/confirm_new_password"
                    android:textColorHint="@color/gray"
                    app:layout_constraintTop_toBottomOf="@+id/editTextPassword"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <Button
                    android:id="@+id/updateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_gap"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    android:background="@drawable/button_background"
                    android:text="@string/update"
                    android:textAllCaps="false"
                    android:textSize="20dp"
                    android:padding="13dp"
                    style="@style/GilroyFontBold"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/editTextPasswordConfirmation" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>